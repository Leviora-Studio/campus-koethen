{
  "kind": "collectionType",
  "collectionName": "locations",
  "info": {
    "singularName": "location",
    "pluralName": "locations",
    "displayName": "Location",
    "description": "A campus location (Standort) such as a town. Channels and calendars name one; a channel and its calendar must share the same location."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 80,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "channels": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::channel.channel",
      "mappedBy": "location"
    },
    "calendars": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::public-calendar.public-calendar",
      "mappedBy": "location"
    }
  }
}
