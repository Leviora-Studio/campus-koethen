{
  "kind": "collectionType",
  "collectionName": "public_calendars",
  "info": {
    "singularName": "public-calendar",
    "pluralName": "public-calendars",
    "displayName": "Calendar",
    "description": "Editorial calendar with optional public Google calendar import."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 80,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 80,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "googleShareUrl": {
      "type": "string",
      "maxLength": 2048,
      "regex": "^https://calendar\\.google\\.com/calendar/(render|u/[0-9]+(/r)?)\\?.*cid=.+$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "colorHex": {
      "type": "string",
      "regex": "^#[0-9a-fA-F]{6}$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "defaultSubscribed": {
      "type": "boolean",
      "default": false,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "includeEventDescription": {
      "type": "boolean",
      "default": false,
      "required": true,
      "description": "Include each imported event's description in the public API and app.",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "includeEventLocation": {
      "type": "boolean",
      "default": false,
      "required": true,
      "description": "Include each imported event's location in the public API and app.",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "channel": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::channel.channel",
      "mappedBy": "publicCalendar",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "entries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::calendar-entry.calendar-entry",
      "mappedBy": "calendar"
    },
    "location": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::location.location",
      "inversedBy": "calendars",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
