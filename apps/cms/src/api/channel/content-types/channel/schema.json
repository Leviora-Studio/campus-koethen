{
  "kind": "collectionType",
  "collectionName": "channels",
  "info": {
    "singularName": "channel",
    "pluralName": "channels",
    "displayName": "Channel",
    "description": "A selectable channel. Channels are fully dynamic: adding one here makes it appear in the app without any code change."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 80,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 80,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "description": {
      "type": "text",
      "maxLength": 500,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "colorHex": {
      "type": "string",
      "required": true,
      "default": "#5B3FD0",
      "minLength": 7,
      "maxLength": 7,
      "regex": "^#[0-9A-Fa-f]{6}$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "defaultSubscribed": {
      "type": "boolean",
      "default": false,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "posts": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::post.post",
      "mappedBy": "channels"
    },
    "publicCalendar": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::public-calendar.public-calendar",
      "inversedBy": "channel",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
